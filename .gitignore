```gitignore
# Python
.venv/
__pycache__/
*.py[cod]

# Environment / secrets
.env
.env.*
!.env.example

# Generated / raw data
data/bronze/
data/silver/
data/gold/*
data/quarantine/

# Keep only dashboard-safe Gold serving JSON files versionable.
!data/gold/serving/
data/gold/serving/*
!data/gold/serving/*.json

# Spark state and local metastore
.spark-warehouse/
metastore_db/
**/checkpoint/
**/checkpoints/
**/checkpoint*/

# Generated outputs
generator/output/
pipeline/output/
analytics/output/
serving/output/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Large local files
*.csv
*.parquet
*.jsonl

# Python caches and environments (including nested copies)
.venv/
**/.venv/
__pycache__/
**/__pycache__/
```